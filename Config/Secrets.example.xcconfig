// Copy to Config/Secrets.xcconfig (git-ignored) and fill in. Anything here
// overrides Config/Base.xcconfig. Leave the Supabase placeholders as they are
// until your backend exists — the app then runs in local-only mode.

DS_TEAM_ID = ABCDE12345
DS_APP_BUNDLE_ID = com.yourname.doomscore
DS_APP_GROUP_ID = group.com.yourname.doomscore

// DS_SUPABASE_URL = https:/$()/YOUR-PROJECT-REF.supabase.co
// DS_SUPABASE_ANON_KEY = YOUR_SUPABASE_ANON_KEY

// Only once you host web/ on your own domain:
// DS_ASSOCIATED_DOMAIN = yourdomain.com
// DS_INVITE_BASE_URL = https:/$()/yourdomain.com/i

// If App/Intents/ForegroundContinuation.swift fails to compile, uncomment:
// DS_SWIFT_FLAGS =
